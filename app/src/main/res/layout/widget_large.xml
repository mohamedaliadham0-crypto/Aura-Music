<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="14dp"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"
        android:adjustViewBounds="true" android:contentDescription="Artwork"
        android:background="@drawable/widget_art_bg" android:clipToOutline="true" android:outlineProvider="background"
        android:scaleType="centerCrop" android:src="@drawable/ic_art_fallback"/>
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="17sp"
        android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#D9FFFFFF" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"/>
    <ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp"
        android:max="1000" android:progress="0" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_shuffle" android:layout_width="24dp" android:layout_height="24dp" android:padding="3dp"
            android:src="@drawable/ic_shuffle" android:contentDescription="Shuffle indicator"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
                android:background="@drawable/widget_btn_bg" android:src="@drawable/ic_prev" android:contentDescription="Previous"/>
            <ImageButton android:id="@+id/w_play" android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:background="@drawable/widget_btn_primary" android:src="@drawable/ic_play" android:contentDescription="Play or pause"/>
            <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
                android:background="@drawable/widget_btn_bg" android:src="@drawable/ic_next" android:contentDescription="Next"/>
        </LinearLayout>
        <View android:layout_width="24dp" android:layout_height="24dp"/>
    </LinearLayout>
</LinearLayout>
