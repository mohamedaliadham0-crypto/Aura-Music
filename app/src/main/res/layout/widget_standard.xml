<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art" android:layout_width="78dp" android:layout_height="78dp"
        android:contentDescription="Artwork" android:background="@drawable/widget_art_bg" android:clipToOutline="true" android:outlineProvider="background" android:scaleType="centerCrop" android:src="@drawable/ic_art_fallback"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp"
            android:max="1000" android:progress="0" android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/w_prev" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                android:background="@drawable/widget_btn_bg" android:src="@drawable/ic_prev" android:contentDescription="Previous"/>
            <ImageButton android:id="@+id/w_play" android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp"
                android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                android:background="@drawable/widget_btn_primary" android:src="@drawable/ic_play" android:contentDescription="Play or pause"/>
            <ImageButton android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                android:background="@drawable/widget_btn_bg" android:src="@drawable/ic_next" android:contentDescription="Next"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
