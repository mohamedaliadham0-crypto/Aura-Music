<resources>
    <style name="Theme.Aura.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#817BE5</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Aura</item>
    </style>
    <style name="Theme.Aura" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aura_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
